# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/vehicle_data

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Pub/Sub Topics
TELEMETRY_TOPIC=vehicle-telemetry
ALERTS_TOPIC=vehicle-alerts
UPDATES_TOPIC=vehicle-updates

# Pub/Sub Subscriptions
TELEMETRY_SUBSCRIPTION=vehicle-telemetry-sub
ALERTS_SUBSCRIPTION=vehicle-alerts-sub
UPDATES_SUBSCRIPTION=vehicle-updates-sub

# Consumer Settings
CONSUMER_BATCH_SIZE=100
CONSUMER_TIMEOUT=5
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1

# Application Settings
APP_NAME=Vehicle Data Service
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Health Check Settings
HEALTH_CHECK_INTERVAL=30

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Debug Settings
SQL_DEBUG=false