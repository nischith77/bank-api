# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/vehicle_data

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# Pub/Sub Channels
TELEMETRY_CHANNEL=vehicle:telemetry
ALERTS_CHANNEL=vehicle:alerts
UPDATES_CHANNEL=vehicle:updates

# Consumer Settings
CONSUMER_BATCH_SIZE=100
CONSUMER_TIMEOUT=5
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1

# Application Settings
APP_NAME=Vehicle Data Service
APP_VERSION=1.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Health Check Settings
HEALTH_CHECK_INTERVAL=30

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Debug Settings
SQL_DEBUG=false
REDIS_DEBUG=false