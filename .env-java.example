# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/vehicle_data
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# GCP Configuration
GCP_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Pub/Sub Topics
TELEMETRY_TOPIC=vehicle-telemetry
ALERTS_TOPIC=vehicle-alerts
UPDATES_TOPIC=vehicle-updates

# Pub/Sub Subscriptions
TELEMETRY_SUBSCRIPTION=vehicle-telemetry-sub
ALERTS_SUBSCRIPTION=vehicle-alerts-sub
UPDATES_SUBSCRIPTION=vehicle-updates-sub

# Application Settings
LOG_LEVEL=INFO
SQL_DEBUG=false
SERVER_PORT=8080

# Consumer Settings
CONSUMER_BATCH_SIZE=100
CONSUMER_TIMEOUT=5
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1

# For local development with Pub/Sub emulator
# PUBSUB_EMULATOR_HOST=localhost:8085